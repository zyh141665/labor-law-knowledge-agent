# 复制本文件为 .env，再填写自己的 DeepSeek API Key。
# 真实密钥不能提交到 Git，也不要发给其他人。
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-flash
# 可选：支持本项目所用 Responses API、工具调用和结构化输出的服务地址。
# 不设置时使用 https://api.deepseek.com；仅支持 Chat Completions 的服务不能直接替换。
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# 访问令牌（必填，缺了后端会拒绝启动）
# ---------------------------------------------------------------------------
# 后端用 AGENT_API_TOKENS：令牌表，格式 令牌:用户ID，多个用逗号分隔。
# 令牌本身就是身份——后端从它认出“你是谁”，请求里带别人的 user_id 会被 403。
# 令牌至少 8 位；用户 ID 只能用字母、数字、下划线、连字符。
# 生成一个：python -c "import secrets;print(secrets.token_urlsafe(24))"
AGENT_API_TOKENS=replace-with-a-long-random-token:alice

# 前端用 AGENT_API_TOKEN：本进程要用的那一把钥匙，从上面挑一个原样填。
AGENT_API_TOKEN=replace-with-a-long-random-token

# 可选：后端地址，默认 http://127.0.0.1:8000。
# AGENT_API_BASE_URL=http://127.0.0.1:8000
